.root
  absolute top left bottom right

.body
  absolute right top bottom
  left $sideNav-width

.body--expanded
  @extend .body
  left $sideNav--folded-width

.slider
  absolute top bottom
  top -2px
  width 0
  z-index 0

.slider-right
  @extend .slider
  width 1px
  z-index 0

.slider--active
  @extend .slider

.slider-right--active
  @extend .slider-right

.slider-hitbox
  absolute top bottom left right
  width 7px
  left -3px
  z-index 10
  cursor col-resize

// ノート一覧ペインの開閉ボタン。サイドバーの « と同じくペイン左下に置く
// （TopBar だと最小幅 120px で検索欄・新規ノートボタンと場所を奪い合う）
.notelist-fold
  position absolute
  bottom 4px
  z-index 11
  width 26px
  height 26px
  padding 0
  border none
  border-radius 4px
  background-color transparent
  color $ui-inactive-text-color
  font-size 14px
  cursor pointer
  &:hover
    // 明暗どちらの地でも読める中間色。$ui-text-color (#333) を固定すると
    // ダークテーマの hover で文字が消える
    color inherit
    background-color alpha($ui-button--active-backgroundColor, 40%)
  &:focus-visible
    outline none
    box-shadow 0 0 0 2px alpha(#ffffff, 0.9), 0 0 0 4px #333333


body[data-theme="dark"]
  .root
    absolute top left bottom right

  .slider-right
  .slider-right--active
    box-shadow none
