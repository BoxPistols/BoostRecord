.control-infoPanel
  position fixed
  pointer-events none
  top 50px
  z-index 200
  line-height normal
  border-radius 4px
  opacity 0
  transition 0.2s

.control-infoButton-panel
  z-index 200
  margin-top 0px
  top: 50px
  right 25px
  position absolute
  padding 12px 14px 8px
  // 幅を決めないと内容次第で広がる。リンクを全幅にするための基準でもある
  width 280px
  box-sizing border-box
  overflow auto
  // ガラスモーフィズム: 半透明 + 背景ブラー。奥が透けることで
  // 「上に浮いている一時的な面」だと分かる
  background-color alpha($ui-noteList-backgroundColor, 88%)
  backdrop-filter blur(20px) saturate(140%)
  -webkit-backdrop-filter blur(20px) saturate(140%)
  border 1px solid alpha(#ffffff, 0.10)
  box-shadow 0 12px 32px rgba(0, 0, 0, 0.34), 0 2px 8px rgba(0, 0, 0, 0.22)
  border-radius 10px

// 値とラベルの階層。従来はラベルも値と同じ 18px で主従が無かった
.modification-date
  font-size 14px
  line-height 20px
  color $ui-text-color

.modification-date-desc
  font-size 12px
  line-height 16px
  color $ui-inactive-text-color

.control-infoButton-panel-trash
  z-index 200
  margin-top 0px
  top 50px
  right 0px
  position absolute
  padding 20px 25px 0 25px
  width 300px
  background-color $ui-noteList-backgroundColor
  box-shadow 2px 12px 15px 2px rgba(0, 0, 0, 0.1), 2px 1px 50px 2px rgba(0, 0, 0, 0.1)
  border-radius 2px

// hr は初期スタイルのままだと太く間隔も広い
hr
  border none
  border-top solid 1px alpha(#808080, 0.25)
  margin 10px 0

.count-wrap
	display flex
	position relative
	width 100%
	gap 12px
	margin-bottom 2px

.count-number
	position relative
	display block
	width 50%
	overflow hidden
	margin 0
	padding 0

// 文字数・ワード数はこのパネルの主役なので、ここだけ少し大きく残す
.infoPanel-defaul-count
  font-size 18px
  line-height 24px
  color $ui-text-color

.infoPanel-sub-count
  font-size 12px
  line-height 16px
  color $ui-inactive-text-color
  padding-bottom 12px

.infoPanel-default
  font-size 14px
  line-height 20px
  color $ui-text-color

.infoPanel-sub
  font-size 12px
  line-height 16px
  font-weight 600
  color $ui-inactive-text-color
  // 詰めすぎると次の項目とくっつく
  padding-bottom 12px

// リンクは頻繁に使うので全幅・少し大きく。コピーボタンは同じ行の右端へ
.infoPanel-noteLink-row
  display flex
  align-items center
  gap 6px
  margin 4px 0 2px

.infoPanel-noteLink
  flex 1
  min-width 0
  height 28px
  padding 0 8px
  font-size 13px
  box-sizing border-box
  // 既定の input 枠は浮いて見えるので、面で示す
  border none
  border-radius 3px
  outline none

.infoPanel-copyButton
  flex 0 0 auto
  outline none
  width 28px
  height 28px
  font-size 14px
  color #A0A0A0
  background-color transparent
  border none
  margin 0 5px
  border-radius 5px
  cursor pointer
  &:hover
    transition 0.2s
    background-color alpha($ui-button--hover-backgroundColor, 30%)
    color $ui-inactive-text-color

.infoPanel-trash
  color #EA4447
  font-weight 600
  font-size 14px
  width 70px
  background-color rgba(226,33,113,0.1)
  border none
  outline none
  border-radius 2px
  margin-right 5px
  padding 2px 5px

[id=export-wrap]
  // アイコン 48px はパネルの主役ではないのに一番目立っていた
  display flex
  align-items flex-start
  margin 8px 0 4px
  button
    // 等幅にしないとアイコンの字幅差でラベルの位置が揃わない
    flex 1 1 0
    min-width 0
    outline none
    font-size 20px
    line-height 26px
    padding 4px 0
    color #A0A0A0
    background-color transparent
    border none
    margin 0 5px
    border-radius 5px
    &:hover
      transition 0.2s
      background-color alpha($ui-button--hover-backgroundColor, 30%)
      color $ui-inactive-text-color
  p
    font-size 12px
    margin 2px 0 0
    color #A0A0A0
    // 収まらない時は縦に割らず省略する
    white-space nowrap
    overflow hidden
    text-overflow ellipsis
    font-weight light
    &:hover
      color $ui-inactive-text-color

.export--enable
  cursor pointer

.export--preview
  cursor pointer
  font-size 22px

.export--unable
  cursor not-allowed

apply-theme(theme)
  body[data-theme={theme}]
    .control-infoButton-panel
      background-color alpha(get-theme-var(theme, 'noteList-backgroundColor'), 88%)

    .control-infoButton-panel-trash
      background-color get-theme-var(theme, 'noteList-backgroundColor')

    .modification-date
      color get-theme-var(theme, 'text-color')

    .modification-date-desc
      color $ui-inactive-text-color

    .infoPanel-defaul-count
      color get-theme-var(theme, 'text-color')

    .infoPanel-sub-count
      color $ui-inactive-text-color

    .infoPanel-default
      color get-theme-var(theme, 'text-color')

    .infoPanel-sub
      color $ui-inactive-text-color

    .infoPanel-noteLink
      background-color alpha(get-theme-var(theme, 'borderColor'), 20%)
      color get-theme-var(theme, 'text-color')

    [id=export-wrap]
      button
        color $ui-dark-inactive-text-color
        &:hover
          background-color alpha(get-theme-var(theme, 'borderColor'), 20%)
          color get-theme-var(theme, 'text-color')
      p
        color $ui-dark-inactive-text-color
        &:hover
          color get-theme-var(theme, 'text-color')

for theme in 'dark' 'solarized-dark' 'dracula'
  apply-theme(theme)

for theme in $themes
  apply-theme(theme)