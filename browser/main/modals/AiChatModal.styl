.root
  modal()
  width 640px
  max-width calc(100vw - 80px)
  height 560px
  max-height calc(100vh - 160px)
  display flex
  flex-direction column
  overflow hidden
  position relative
  outline none

.header
  display flex
  align-items center
  justify-content space-between
  padding 16px 20px 12px
  border-bottom $ui-border

.title
  font-size 18px
  font-weight 600
  color inherit

.log
  flex 1 1 auto
  overflow-y auto
  padding 16px 20px

.empty
  font-size 14px
  line-height 1.7
  color $ui-inactive-text-color
  p
    margin 0 0 8px

.message--user
  margin-bottom 16px
  padding 10px 12px
  border-radius 6px
  background-color rgba(128, 128, 128, 0.14)

.message--assistant
  margin-bottom 16px
  padding 10px 12px
  border-radius 6px
  background-color rgba(128, 128, 128, 0.06)
  border 1px solid rgba(128, 128, 128, 0.18)

.message-role
  font-size 12px // A11y: 12px 未満を使わない
  font-weight 700
  letter-spacing 0.04em
  color $ui-inactive-text-color
  margin-bottom 6px

.message-body
  font-size 14px
  line-height 1.7
  white-space pre-wrap
  word-break break-word
  color inherit

.message-insert
  margin-top 10px
  border 1px solid rgba(128, 128, 128, 0.4)
  border-radius 4px
  background transparent
  color inherit
  font-family inherit
  font-size 12px // A11y: 12px 未満を使わない
  padding 4px 10px
  cursor pointer
  &:hover
    background-color rgba(128, 128, 128, 0.16)

.error
  margin 0 20px 8px
  padding 8px 10px
  border-radius 4px
  font-size 12px // A11y: 12px 未満を使わない
  line-height 1.6
  border 1px solid rgba(191, 54, 12, 0.5)
  background-color rgba(191, 54, 12, 0.08)
  color inherit

.control
  flex 0 0 auto
  padding 12px 20px 16px
  border-top $ui-border

.context-toggle
  display block
  font-size 12px // A11y: 12px 未満を使わない
  color $ui-inactive-text-color
  margin-bottom 8px

.input
  display block
  width 100%
  box-sizing border-box
  min-height 72px
  resize vertical
  font-family inherit
  font-size 14px
  line-height 1.6
  padding 8px 10px
  border 1px solid rgba(128, 128, 128, 0.4)
  border-radius 4px
  background-color transparent
  color inherit
  outline none

.control-row
  display flex
  align-items center
  justify-content space-between
  gap 10px
  margin-top 8px

.hint
  font-size 12px // A11y: 12px 未満を使わない
  color $ui-inactive-text-color

.send
  colorPrimaryButton()
  border none
  border-radius 4px
  font-size 14px
  height 32px
  padding 0 20px
  cursor pointer
  &:disabled
    opacity 0.5
    cursor default

// 明暗は .root の色を継承させる。個々の要素に色を固定すると、
// テーマを足すたびに書き漏らしが出る
apply-theme(theme)
  body[data-theme={theme}]
    .root
      background-color get-theme-var(theme, 'backgroundColor')
      color get-theme-var(theme, 'text-color')
    .header
      border-color get-theme-var(theme, 'borderColor')
    .control
      border-color get-theme-var(theme, 'borderColor')
    .input
      border-color get-theme-var(theme, 'borderColor')
    .send
      colorThemedPrimaryButton(theme)

body[data-theme="dark"]
  .root
    background-color $ui-dark-backgroundColor
    color $ui-dark-text-color
  .header
    border-color $ui-dark-borderColor
  .control
    border-color $ui-dark-borderColor
  .input
    border-color $ui-dark-borderColor
  .send
    colorDarkPrimaryButton()

// 'white' はモーダル用の変数を持たないので入れない（空の宣言が出る）。
// 'dark' は上の明示ブロックで扱う
for theme in 'solarized-dark' 'dracula'
  apply-theme(theme)

for theme in $themes
  apply-theme(theme)

// 対象の選択（選択範囲 / ノート全体）
.scope
  display flex
  align-items center
  gap 16px
  padding 10px 20px
  border-bottom $ui-border
  font-size 13px

.scope-label
  color $ui-inactive-text-color

.scope-option
  display inline-flex
  align-items center
  gap 6px
  cursor pointer
  input
    margin 0

.scope-option--off
  @extend .scope-option
  opacity 0.45
  cursor default

.scope-meta
  font-size 12px
  color $ui-inactive-text-color

// 直した全文のプレビュー
.revised
  margin-top 10px
  border 1px solid rgba(128, 128, 128, 0.35)
  border-radius 6px
  overflow hidden

.revised-head
  display flex
  justify-content space-between
  align-items center
  padding 6px 10px
  font-size 12px
  background rgba(128, 128, 128, 0.15)
  border-bottom 1px solid rgba(128, 128, 128, 0.35)

.revised-meta
  color $ui-inactive-text-color

.revised-body
  margin 0
  padding 10px 12px
  max-height 260px
  overflow auto
  font-family inherit
  font-size 13px
  line-height 1.6
  white-space pre-wrap
  word-break break-word

.revised-actions
  display flex
  gap 8px
  padding 8px 10px
  border-top 1px solid rgba(128, 128, 128, 0.35)

.apply
  padding 6px 14px
  border none
  border-radius 4px
  background $ui-active-color
  color #fff
  font-family inherit
  font-size 13px
  cursor pointer
  &:disabled
    opacity 0.6
    cursor default

.apply--done
  @extend .apply
  background rgba(128, 128, 128, 0.35)

// よく使う指示
.quick
  display flex
  flex-wrap wrap
  gap 6px
  margin-bottom 8px

.quick-button
  padding 4px 10px
  border 1px solid rgba(128, 128, 128, 0.4)
  border-radius 12px
  background transparent
  color inherit
  font-family inherit
  font-size 12px
  cursor pointer
  &:hover
    background rgba(128, 128, 128, 0.15)
  &:disabled
    opacity 0.45
    cursor default
