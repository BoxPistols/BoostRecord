{
  "presets": ["@babel/preset-react", "@babel/preset-env"],
  "plugins": ["add-module-exports"],
  "env": {
    "test": {
      "presets": [
        ["@babel/preset-env", { "targets": { "node": "current" } }],
        "@babel/preset-react"
      ],
      "plugins": [
        "add-module-exports",
        [ "babel-plugin-webpack-alias-7", { "config": "./babel-alias.config.js" } ]
      ]
    }
  }
}
