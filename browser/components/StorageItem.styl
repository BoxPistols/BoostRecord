.root
  width 100%
  user-select none

.folderList-item
  display flex
  // 連番バッジを絶対配置で重ねるための基準
  position relative
  width 100%
  height 34px
  background-color transparent
  color $ui-inactive-text-color
  padding 0
  text-align left
  border none
  overflow ellipsis
  font-size 14px
  align-items: center
  &:first-child
    margin-top 0
  &:hover
    color #1EC38B;
    background-color alpha($ui-button-default--active-backgroundColor, 20%)
    transition background-color 0.15s
  &:active
    color $$ui-button-default-color
    background-color alpha($ui-button-default--active-backgroundColor, 20%)

.folderList-item--active
  @extend .folderList-item
  color #1EC38B
  background-color alpha($ui-button-default--active-backgroundColor, 20%)
  &:hover
    color #1EC38B;
    background-color alpha($ui-button-default--active-backgroundColor, 50%)

.folderList-item-name
  display block
  flex 1
  // flex 子は既定で min-width auto のため、内容が縮まず溢れる
  min-width 0
  white-space nowrap
  padding-right: 10px
  border-width 0 0 0 2px
  border-style solid
  border-color transparent
  overflow hidden
  text-overflow ellipsis

.folderList-item-rename-input
  // その場編集の入力欄。行の見た目を保ったまま名前部分だけ差し替える。
  // 色は行から継承する（テーマ別の指定を足さずに全テーマで読める）
  width calc(100% - 24px)
  padding 1px 4px
  border none
  border-bottom 1px solid $ui-active-color
  border-radius 0
  background transparent
  color inherit
  font-size inherit
  font-family inherit
  line-height inherit
  outline none

.folderList-item-noteCount
  float right
  line-height 26px
  padding-right 15px
  font-size 13px

.folderList-item-tooltip
  tooltip()
  position fixed
  padding 0 10px
  left 44px
  z-index 10
  pointer-events none
  opacity 0
  border-top-right-radius 2px
  border-bottom-right-radius 2px
  height 34px
  line-height 32px
  transition-property opacity

.folderList-item:hover, .folderList-item--active:hover
  .folderList-item-tooltip
    opacity 1

.folderList-item-name--folded
  @extend .folderList-item-name
  padding-left 0            // was 7px — drop left bias so the glyph + letter center
  text-align center         // center the <i> icon + 1-letter abbreviation in the 44px column
  .folderList-item-icon
    font-size 16px          // was 9px — enlarge the folder/file icon
    padding-right 0         // was inherited 10px — was shifting the glyph off-center

.folderList-item-icon
  padding-right: 10px

.folderList-item-reorder
  font-size: 12px // A11y: 12px 未満を使わない
  padding: 10px 8px 10px 9px;
  color: rgba(147, 147, 149, 0.3)
  cursor: ns-resize
  &:before
    content: "\f142 \f142"

body[data-theme="white"]
  .folderList-item
    color $ui-inactive-text-color
    &:hover
      color $ui-text-color
      background-color alpha($ui-button--active-backgroundColor, 20%)
      transition background-color 0.15s
    &:active
      color $ui-text-color
      background-color $ui-button--active-backgroundColor

  .folderList-item--active
    @extend .folderList-item
    color $ui-text-color
    background-color $ui-button--active-backgroundColor
    &:hover
      color $ui-text-color
      background-color alpha($ui-button--active-backgroundColor, 50%)

body[data-theme="dark"]
  .folderList-item
    &:hover
      background-color alpha($ui-dark-button--active-backgroundColor, 20%)
      color $ui-dark-text-color
    &:active
      color $ui-dark-text-color
      background-color $ui-dark-button--active-backgroundColor

  .folderList-item--active
    @extend .folderList-item
    color $ui-dark-text-color
    background-color $ui-dark-button--active-backgroundColor
    &:active
      background-color alpha($ui-dark-button--active-backgroundColor, 50%)
    &:hover
      color $ui-dark-text-color
      background-color alpha($ui-dark-button--active-backgroundColor, 50%)

apply-theme(theme)
  body[data-theme={theme}]
    .folderList-item
      &:hover
        background-color get-theme-var(theme, 'button-backgroundColor')
        color get-theme-var(theme, 'text-color')
      &:active
        color get-theme-var(theme, 'text-color')
        background-color get-theme-var(theme, 'button-backgroundColor')

    .folderList-item--active
      @extend .folderList-item
      color get-theme-var(theme, 'text-color')
      background-color get-theme-var(theme, 'button-backgroundColor')
      &:active
        background-color get-theme-var(theme, 'button-backgroundColor')
      &:hover
        color get-theme-var(theme, 'text-color')
        background-color get-theme-var(theme, 'button-backgroundColor')

for theme in 'solarized-dark' 'dracula'
  apply-theme(theme)

for theme in $themes
  apply-theme(theme)
// 修飾キー長押し中に出す 1..9 の連番バッジ
.folderList-item-jump-hint
  // 行の中に流し込むとラベルを押し出して折り返しを起こすので、重ねて出す
  position absolute
  left 2px
  top 50%
  transform translateY(-50%)
  z-index 2
  min-width 16px
  height 16px
  padding 0 3px
  border-radius 3px
  background-color alpha(#000, 70%)
  color #fff
  font-size 12px
  line-height 16px
  text-align center
  pointer-events none

// --- 多階層ツリー ---
// インデントは幅だけ持つ空要素。深さの表現をここに集約する
.folderList-item-indent
  flex-shrink 0
  display inline-block

// 開閉トグル。button の入れ子は不正なので span + role='button' で作る
.folderList-item-expander
  flex-shrink 0
  width 14px
  text-align center
  color $ui-inactive-text-color
  cursor pointer
  &:hover
    color $ui-text-color

// 子を持たない行と桁を揃える（揃えないと同階層がガタつく）
.folderList-item-expander-spacer
  flex-shrink 0
  display inline-block
  width 14px
